  "links": {
    "value_shape": {
      "wikilink": "a quoted string \"[[Target]]\"; the target is the note's name, the same value shape goal, key_element and project already use",
      "wikilink_list": "a flat list of quoted wikilink strings; never a list of maps",
      "bare_text_is_not_a_link": true,
      "full_path_when_names_collide": "\"[[folder/Name]]\" where two notes share a name by design (planner_habit, linked_note)"
    },
    "rules": [
      {
        "id": "link-rule",
        "applies_to": "note",
        "require_any_of": [
          "projects",
          "key_elements",
          "topics"
        ],
        "may_carry": [
          "people",
          "companies"
        ],
        "on_fail": "the note failed the Capturing Beast and should not exist; the validator fails it"
      },
      {
        "id": "document-link-rule",
        "applies_to": "document",
        "optional_any_of": [
          "projects",
          "key_elements",
          "topics"
        ],
        "may_carry": [
          "people",
          "companies"
        ],
        "note": "same three lists, optional, because a document is often filed for a contact and nothing else"
      },
      {
        "id": "project-needs-goal",
        "applies_to": "project",
        "require": "goal",
        "note": "No project without a goal. If none fits, the goal is created first."
      },
      {
        "id": "document-needs-binary",
        "applies_to": "document",
        "require": "source_file",
        "target_concept": "assets",
        "note": "Wrapper-note pattern: the binary never carries metadata."
      },
      {
        "id": "processed-stamp",
        "applies_to": [
          "scratchpad",
          "capture",
          "document"
        ],
        "shape": {
          "processed": true,
          "processed_summary": "one line",
          "processed_into": "at least one quoted wikilink"
        }
      },
      {
        "id": "one-fact-one-note",
        "note": "A field lives in exactly one note; habit meaning and planner-habit schedule never both carry the same fact. A derivable fact is not a field."
      }
    ]
  },
