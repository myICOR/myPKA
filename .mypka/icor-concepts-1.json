  "versioning": {
    "major": 1,
    "consumer_range": ">=1 <2",
    "same_major_allows": [
      "a new optional field on an existing type",
      "a new enum value that no required field depends on",
      "a new concept or type that no consumer is required to use",
      "wording, notes, examples"
    ],
    "needs_new_major": [
      "renaming or removing a concept, a type, or a field",
      "adding a required field or making an optional field required",
      "narrowing an enum, or changing a field's kind",
      "changing the link rule or a relation's target type",
      "changing a concept's default_path (mode A byte-identity, plan T3)"
    ],
    "on_mismatch": "refuse with the named reason (plan step 9, T5)"
  },
  "rooms": [
    {
      "path": "00 Daily Scratchpad",
      "question": "what did the user write down today, raw?",
      "persistence": "forever, never edited by AI",
      "side": "source",
      "concepts": [
        "scratchpad"
      ]
    },
    {
      "path": "01 Inbox",
      "question": "what has been handed to the team and not yet processed?",
      "persistence": "active part empties; Outer World originals archived forever",
      "side": "source",
      "concepts": [
        "inbox"
      ]
    },
    {
      "path": "02 Planner",
      "question": "what external tasks and plans is the user working with this week?",
      "persistence": "machine-tended by the ICOR Planner plugin; never hand-curated",
      "side": "source",
      "concepts": [
        "planner"
      ]
    },
    {
      "path": "03 WiP",
      "question": "what is being worked on right now?",
      "persistence": "temporary; retires to _archive",
      "side": "source",
      "concepts": [
        "wip"
      ]
    },
    {
      "path": "04 Inner World",
      "question": "what does the user know and who do they know?",
      "persistence": "forever, curated",
      "side": "source",
      "concepts": [
        "journal",
        "people",
        "companies",
        "key_elements",
        "goals",
        "projects",
        "habits",
        "topics",
        "notes",
        "journey_notes"
      ]
    },
    {
      "path": "05 Assets",
      "question": "which binary file does this note embed?",
      "persistence": "forever",
      "side": "source",
      "concepts": [
        "assets"
      ]
    },
    {
      "path": "06 AI Team",
      "question": "how does the team operate?",
      "persistence": "forever, versioned by editing",
      "side": "shared",
      "concepts": [
        "templates",
        "life_guidelines"
      ],
      "note": "Split room. The team concepts under it resolve under the myPKA root; in the ICOR for Life folder it also holds the source concepts templates and life_guidelines (read-only for the team)."
    },
    {
      "path": "07 Databases",
      "question": "which dataset is too big or too row-shaped for notes?",
      "persistence": "forever; sources only, never a database anything regenerates",
      "side": "source",
      "concepts": [
        "databases"
      ]
    }
  ],
